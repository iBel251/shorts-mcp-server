# ---- Required ----
# xAI API key. Server-side only. Never returned to a client, never logged.
XAI_API_KEY=

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (not the anon key) — needed to write Storage + bypass RLS.
SUPABASE_SERVICE_KEY=

# Shared secret. Sent either as a header or as the URL path segment
#   https://<host>/<SHORTS_SHARED_SECRET>
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHORTS_SHARED_SECRET=

# ---- Model config (swap models by config, not code) ----
VIDEO_MODEL=grok-imagine-video
VIDEO_RESOLUTION=720p
IMAGE_MODEL=grok-imagine-image-quality

# ---- Optional ----
PORT=3000
XAI_BASE_URL=https://api.x.ai/v1
SUPABASE_BUCKET=shorts
# Header name for the shared secret. claude.ai only forwards an allowlisted set
# (authorization, x-api-key, x-auth-token); all three are accepted regardless.
AUTH_HEADER=x-api-key
# Background worker poll interval (ms)
JOB_POLL_INTERVAL_MS=10000
# Give up on an upstream video job after this long (ms). Default 30 min.
JOB_TIMEOUT_MS=1800000
LOG_LEVEL=info

# Advertise MCP Apps UI widgets (inline gallery + video player). Default true.
#
# Kill switch, not a preference. Declaring a UI resource on a tool appears to
# change how some hosts handle that tool's result: the result is routed to the
# widget and the image content blocks may stop reaching the model. That trade is
# bad — the model comparing first/last frames is the load-bearing quality check
# and a widget the human looks at does not replace it.
#
# Set to false in the host dashboard and restart to turn widgets off in seconds
# without a code change. Removes both the resources and the tools' _meta.
ENABLE_MCP_APPS=true
